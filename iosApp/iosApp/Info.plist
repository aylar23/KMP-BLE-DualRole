<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>

	<!-- BLE usage description (required for App Store review) -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>BleDuoRole uses Bluetooth to discover nearby peers and exchange messages without internet.</string>

	<!-- Background modes for sustained BLE scanning and advertising -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
</dict>
</plist>